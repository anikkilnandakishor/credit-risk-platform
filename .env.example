# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (for talk-to-data / application storage)
DATABASE_URL=sqlite:///./data/credit_risk.db

# LLM (natural language to SQL) — set one or both keys
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ML
MODEL_PATH=models/saved_model.pkl
RANDOM_STATE=42
